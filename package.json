{
  "name": "simple-usb-c-pd-peltier-driver",
  "version": "0.3.0",
  "description": "Editable four-layer USB-C PD Peltier driver, based on 0hmX/dual-usb-peltier-assembly",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx",
    "build:cloud": "bun run scripts/pack-site-preview.ts unpack",
    "build:preview": "tsci build --site --transpile --all-images --pcb-png --schematic-png --svgs --glbs --disable-parts-engine && bun run scripts/build-assembly.ts --site-preview && bun run scripts/pack-site-preview.ts pack",
    "snapshot": "tsci snapshot",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "best:build": "bun run scripts/build-best-version.ts",
    "designs:build": "bun run scripts/build-product-designs.tsx",
    "designs:route-check": "bun run scripts/validate-product-routing.tsx",
    "designs:review": "bun run typecheck && bun test ./tests/product-designs.test.tsx ./tests/modular-contract.test.tsx ./tests/product-economics.test.ts ./tests/product-design-artifacts.test.tsx",
    "routing:rebind": "bun run scripts/rebind-routing.tsx",
    "export:schematics": "bun run scripts/export-schematics.ts",
    "build:assembly": "tsci build assembly.tsx --disable-parts-engine && bun run scripts/build-assembly.ts",
    "check:netlist": "tsci check netlist index.circuit.tsx",
    "check:schematic": "tsci check schematic-placement index.circuit.tsx",
    "check:placement": "tsci check placement index.circuit.tsx",
    "check:shorts": "tsci check shorts index.circuit.tsx",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@flatten-js/core": "1.6.14",
    "@resvg/resvg-js": "2.6.2",
    "@tscircuit/parts-engine": "0.0.37",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.8",
    "circuit-json-to-gltf": "0.0.151",
    "circuit-to-svg": "0.0.450",
    "earcut": "3.2.4",
    "flatbush": "4.6.2",
    "jscad-planner": "0.0.19",
    "poppygl": "0.0.34",
    "three": "0.179.1",
    "tscircuit": "0.0.2868",
    "typescript": "^5.0.0"
  },
  "private": true,
  "type": "module",
  "license": "MIT"
}
